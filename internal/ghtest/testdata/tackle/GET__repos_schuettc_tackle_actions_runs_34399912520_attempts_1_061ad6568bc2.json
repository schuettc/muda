uettc/followers","following_url":"https://api.github.com/users/schuettc/following{/other_user}","gists_url":"https://api.github.com/users/schuettc/gists{/gist_id}","starred_url":"https://api.github.com/users/schuettc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schuettc/subscriptions","organizations_url":"https://api.github.com/users/schuettc/orgs","repos_url":"https://api.github.com/users/schuettc/repos","events_url":"https://api.github.com/users/schuettc/events{/privacy}","received_events_url":"https://api.github.com/users/schuettc/received_events","type":"User","user_view_type":"public","site_admin":false},"jobs_url":"https://api.github.com/repos/schuettc/tackle/actions/runs/34399912520/attempts/1/jobs","logs_url":"https://api.github.com/repos/schuettc/tackle/actions/runs/34399912520/attempts/1/logs","check_suite_url":"https://api.github.com/repos/schuettc/tackle/check-suites/93192094608","artifacts_url":"https://api.github.com/repos/schuettc/tackle/actions/runs/34399912520/artifacts","cancel_url":"https://api.github.com/repos/schuettc/tackle/actions/runs/34399912520/cancel","rerun_url":"https://api.github.com/repos/schuettc/tackle/actions/runs/34399912520/rerun","previous_attempt_url":null,"workflow_url":"https://api.github.com/repos/schuettc/tackle/actions/workflows/345598808","head_commit":{"id":"ea762131fed14c75bf8e104c947fc5ea0720040d","tree_id":"fe58003a2caafcfe8c47bdb4f6c8ac742d1f8cac","message":"proj: model selection in the new-work picker\n\nMirror agent selection with a per-agent model choice. While naming new work,\nTab cycles the agent and Shift-Tab opens a filterable list of that agent's\nmodels (type to filter, arrows to move, enter to pick, esc to keep the\ncurrent). Changing the agent re-seeds the model to its default. The choice\nrides out in Result.Model and is woven into the launch as `claude --model <id>\n…` / `pi --model <provider/id> …` (empty model → agent's own default;\ncursor/none ignore it).\n\nModel menus are per-agent: claude's is a built-in Anthropic list (Claude Code\ncan't enumerate its models), pi's is discovered from `pi --list-models`,\nfiltered to the providers named under [model_providers] in config.toml and\ncached ~24h at ~/.cache/proj/pi-models.txt. A per-project default_model pins a\nproject's model (honoured on the interactive path and the proj new path; no\nCLI flag).\n\nThreads a model arg through EnsureSession/agentLaunchCmd; the model overlay\nreuses the picker's filter/window machinery and an injected models resolver so\ntests never shell out to pi.","timestamp":"2026-09-09T19:44:34Z","author":{"name":"Court Schuett","email":"court@subaud.io"},"committer":{"name":"Court Schuett","email":"court@subaud.io"}},"repository":{"id":1300559398,"node_id":"R_kgDOTYT2Jg","name":"tackle","full_name":"schuettc/tackle","private":false,"owner":{"login":"schuettc","id":71404236,"node_id":"MDQ6VXNlcjcxNDA0MjM2","avatar_url":"https://avatars.githubusercontent.com/u/71404236?v=4","gravatar_id":"","url":"https://api.github.com/users/schuettc","html_url":"https://github.com/schuettc","followers_url":"https://api.github.com/users/schuettc/followers","following_url":"https://api.github.com/users/schuettc/following{/other_user}","gists_url":"https://api.github.com/users/schuettc/gists{/gist_id}","starred_url":"https://api.github.com/users/schuettc/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/schuettc/subscriptions","organizations_url":"https://api.github.com/users/schuettc/orgs","repos_url":"https://api.github.com/users/schuettc/repos","events_url":"https://api.github.com/users/schuettc/events{/privacy}","received_events_url":"https://api.github.com/users/schuettc/received_events","type":"User","user_view_type":"public","site_admin":false},"html_url":"https://github.com/schuettc/tackle","description":"A fast, keyboard-first per-worktree markdown scratchpad TUI (Go / Bubble Tea)","fork":false,"url":"https://api.github.com/repos/schuettc/tackle",